
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      // isOwner is only called after isSignedIn, so request.auth is safe.
      return request.auth.uid == userId;
    }
    
    function hasPermission(permission) {
      // 1. Must be signed in to have any permission.
      if (!isSignedIn()) {
        return false;
      }

      // 2. Get the user's data from the /users collection.
      let userData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      
      // If user document doesn't exist, they have no permissions.
      if (userData == null || !('profileId' in userData)) {
        return false;
      }
      
      // 3. Check for Admin override.
      if (userData.profileId == 'Administrador' || userData.profileId == 'Administrador(a)') {
        return true;
      }
      
      // 4. Check for individual custom permissions on the user document.
      if ('customPermissions' in userData && permission in userData.customPermissions) {
          return true;
      }

      // 5. Check for permissions granted by the user's profile.
      let profilePath = /databases/$(database)/documents/profiles/$(userData.profileId);
      if (exists(profilePath)) {
        let profileData = get(profilePath).data;
        if ('permissions' in profileData && permission in profileData.permissions.toSet()) {
          return true;
        }
      }
        
      return false;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow read, list: if hasPermission('view:users') || hasPermission('manage:users');
      allow create, update: if isOwner(userId) || hasPermission('manage:users');
      allow delete: if hasPermission('manage:users');
    }
    
    match /profiles/{profileId} {
        allow read, list: if hasPermission('view:profiles') || hasPermission('manage:profiles');
        allow write: if hasPermission('manage:profiles');
    }

    match /alunos/{alunoId} {
      allow read, list: if hasPermission('view:students') || hasPermission('manage:students');
      allow write: if hasPermission('manage:students');
    }

    match /grades/{gradeId} {
       allow read, list: if hasPermission('view:grades') || hasPermission('manage:grades');
       allow write: if hasPermission('manage:grades');
    }

    match /attendance/{attendanceId} {
       allow read, list: if hasPermission('view:attendance') || hasPermission('manage:attendance');
       allow write: if hasPermission('manage:attendance');
    }
    
    match /announcements/{announcementId} {
      allow read, list: if hasPermission('view:announcements') || hasPermission('manage:announcements');
      allow write: if hasPermission('manage:announcements');
    }
  }
}
