
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      // isOwner is only called after isSignedIn, so request.auth is safe.
      return request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getProfileData(profileId) {
        return get(/databases/$(database)/documents/profiles/$(profileId)).data;
    }

    function hasPermission(permission) {
      if (!isSignedIn()) {
        return false;
      }
      
      let userData = getUserData();
      if (userData == null || !('profileId' in userData)) {
        return false;
      }
      
      if (userData.profileId in ['Administrador', 'Administrador(a)']) {
        return true;
      }
      
      if ('customPermissions' in userData && userData.customPermissions.hasAny([permission])) {
        return true;
      }

      let profileData = getProfileData(userData.profileId);
      if ('permissions' in profileData && profileData.permissions.hasAny([permission])) {
        return true;
      }
        
      return false;
    }

    // --- Collection Rules ---

    // Users can update their own data.
    // Any authenticated user can READ another user's profile (needed for `hasPermission`).
    match /users/{userId} {
      allow read, list: if isSignedIn();
      allow create, update: if isOwner(userId) || hasPermission('manage:users');
      allow delete: if hasPermission('manage:users');
    }
    
    // All authenticated users can read/list profiles.
    // Only those with 'manage:cadastros' can write.
    match /profiles/{profileId} {
        allow read, list: if isSignedIn();
        allow write: if hasPermission('manage:cadastros');
    }

    // Permissions for students.
    match /alunos/{alunoId} {
      allow read, list: if hasPermission('view:students') || hasPermission('manage:students');
      allow write: if hasPermission('manage:students');
    }

    // Permissions for employees.
    match /funcionarios/{funcionarioId} {
      allow read, list, write: if hasPermission('manage:cadastros');
    }

    // Permissions for disciplines.
    match /disciplinas/{disciplinaId} {
       allow read, list, write: if hasPermission('manage:cadastros');
    }

    // Permissions for grades.
    match /grades/{gradeId} {
       allow read: if isSignedIn();
       allow write: if hasPermission('manage:grades');
    }

    // Permissions for attendance.
    match /attendance/{attendanceId} {
       allow read: if isSignedIn();
       allow write: if hasPermission('manage:attendance');
    }
    
    // Permissions for announcements.
    match /announcements/{announcementId} {
      allow read, list: if isSignedIn();
      allow write: if hasPermission('manage:announcements');
    }
  }
}
