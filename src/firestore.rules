
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      // isOwner is only called after isSignedIn, so request.auth is safe.
      return request.auth.uid == userId;
    }

    // --- Collection Rules ---

    // Users can update their own data.
    // Any authenticated user can READ another user's profile (needed for `hasPermission`).
    match /users/{userId} {
      allow read, list: if isSignedIn();
      allow create, update: if isOwner(userId) || (
          isSignedIn() && 
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.profileId in ['Administrador', 'Administrador(a)'] ||
          'manage:users' in get(/databases/$(database)/documents/profiles/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.profileId)).data.permissions)
      );
      allow delete: if isSignedIn() && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.profileId in ['Administrador', 'Administrador(a)'] ||
          'manage:users' in get(/databases/$(database)/documents/profiles/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.profileId)).data.permissions
      );
    }
    
    // All authenticated users can read/list profiles.
    // Only those with 'manage:cadastros' can write.
    match /profiles/{profileId} {
        allow read, list: if isSignedIn();
        allow write: if isSignedIn() && (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.profileId in ['Administrador', 'Administrador(a)'] ||
            'manage:cadastros' in get(/databases/$(database)/documents/profiles/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.profileId)).data.permissions
        );
    }

    // Permissions for students.
    match /alunos/{alunoId} {
      allow read, list: if isSignedIn() && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.profileId in ['Administrador', 'Administrador(a)'] ||
          'manage:students' in get(/databases/$(database)/documents/profiles/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.profileId)).data.permissions ||
          'view:students' in get(/databases/$(database)/documents/profiles/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.profileId)).data.permissions
      );
      allow write: if isSignedIn() && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.profileId in ['Administrador', 'Administrador(a)'] ||
          'manage:students' in get(/databases/$(database)/documents/profiles/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.profileId)).data.permissions
      );
    }

    // Permissions for employees.
    match /funcionarios/{funcionarioId} {
      allow read, list, write: if isSignedIn() && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.profileId in ['Administrador', 'Administrador(a)'] ||
          'manage:cadastros' in get(/databases/$(database)/documents/profiles/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.profileId)).data.permissions
      );
    }

    // Permissions for disciplines.
    match /disciplinas/{disciplinaId} {
       allow read, list, write: if isSignedIn() && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.profileId in ['Administrador', 'Administrador(a)'] ||
          'manage:cadastros' in get(/databases/$(database)/documents/profiles/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.profileId)).data.permissions
      );
    }

    // Permissions for grades.
    match /grades/{gradeId} {
       allow read: if isSignedIn();
       allow write: if isSignedIn() && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.profileId in ['Administrador', 'Administrador(a)'] ||
          'manage:grades' in get(/databases/$(database)/documents/profiles/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.profileId)).data.permissions
       );
    }

    // Permissions for attendance.
    match /attendance/{attendanceId} {
       allow read: if isSignedIn();
       allow write: if isSignedIn() && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.profileId in ['Administrador', 'Administrador(a)'] ||
          'manage:attendance' in get(/databases/$(database)/documents/profiles/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.profileId)).data.permissions
       );
    }
    
    // Permissions for announcements.
    match /announcements/{announcementId} {
      allow read, list: if isSignedIn();
      allow write: if isSignedIn() && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.profileId in ['Administrador', 'Administrador(a)'] ||
          'manage:announcements' in get(/databases/$(database)/documents/profiles/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.profileId)).data.permissions
      );
    }
  }
}
