
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserProfile() {
      let userData = getUserData();
      if (!('profileId' in userData)) {
        return null;
      }
      // Use a direct path string, not template literals inside functions
      return get(path('/databases/' + database + '/documents/profiles/' + userData.profileId)).data;
    }
    
    function hasPermission(permission) {
      let userData = getUserData();
      let userProfile = getUserProfile();
      
      if (userData.profileId == 'Administrador') {
        return true;
      }
      
      if (userProfile != null && 'permissions' in userProfile && userProfile.permissions.hasAny([permission])) {
        return true;
      }
        
      if (userData.customPermissions != null && userData.customPermissions.hasAny([permission])) {
        return true;
      }

      return false;
    }

    match /users/{userId} {
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow read: if isSignedIn() && (request.auth.uid == userId || hasPermission('manage:users'));
      // Allow listing teachers if user can manage classes, otherwise require manage:users
      allow list: if (hasPermission('manage:classes') && resource.data.profileId == 'Professor') || hasPermission('manage:users');
      allow write: if hasPermission('manage:users');
    }
    
    match /profiles/{profileId} {
        allow write: if hasPermission('manage:profiles');
        allow read, list: if isSignedIn();
    }

    match /classes/{classId} {
      allow read, list: if isSignedIn();
      allow write: if hasPermission('manage:classes');
    }
    
    match /grades/{gradeId} {
       allow read: if isSignedIn();
       allow write: if hasPermission('manage:grades');
    }

    match /attendance/{attendanceId} {
       allow read: if isSignedIn();
       allow write: if hasPermission('manage:attendance');
    }
    
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if hasPermission('manage:announcements');
    }

    match /alunos/{alunoId} {
      allow read, write, list: if isSignedIn();
    }
  }
}
