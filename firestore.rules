
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      if (!isSignedIn()) return false;
      // Super-admins por email (acesso imediato)
      if (request.auth.token.email.lower() in ['mestrejpfg@gmail.com', 'fortalezaem@gmail.com']) return true;
      
      // Admin por perfil no Firestore
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(userPath) && get(userPath).data.get('profileId', '') in ['Administrador', 'Administrador(a)'];
    }
    
    function hasPermission(permission) {
      if (!isSignedIn()) return false;
      if (isAdmin()) return true;

      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      if (!exists(userPath)) return false;
      
      let userData = get(userPath).data;
      
      // 1. Verificar em permissões customizadas (Array)
      if (permission in userData.get('customPermissions', [])) return true;

      // 2. Verificar via Perfil (Mapa de booleanos)
      let pId = userData.get('profileId', '');
      if (pId != '') {
        let profilePath = /databases/$(database)/documents/profiles/$(pId);
        if (exists(profilePath)) {
          let perms = get(profilePath).data.get('permissions', {});
          return perms.get(permission, false) == true;
        }
      }

      return false;
    }

    // Regra Mestra: Administradores têm acesso total
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Usuários
    match /users/{userId} {
      // Usuário sempre pode ler e atualizar seu próprio perfil. Gestores podem listar.
      allow get, create, update: if isSignedIn() && (request.auth.uid == userId || hasPermission('manage:users'));
      allow list, delete: if hasPermission('manage:users') || hasPermission('manage:database');
    }
    
    // Perfis de Acesso
    match /profiles/{profileId} {
      allow read, list: if isSignedIn();
      allow write: if hasPermission('manage:users') || hasPermission('manage:database');
    }

    // Alunos e Ex-Alunos
    match /alunos/{alunoId} {
      allow read, list, write: if hasPermission('manage:students') || hasPermission('manage:migration');
    }
    
    match /exalunos/{alunoId} {
      allow read, list, write: if hasPermission('manage:students') || hasPermission('manage:migration');
    }

    // Funcionários (RH)
    match /servidores/{servidorId} {
      allow read, list, write: if hasPermission('manage:cadastros');
    }

    // Registro de Ocorrências
    match /ocorrencias/{ocorrenciaId} {
      allow read, list, write: if hasPermission('manage:occurrences');
    }

    // Notas e Desempenho
    match /grades/{gradeId} {
       allow read, list, write: if hasPermission('manage:grades');
    }

    // Registro de Frequência
    match /attendance/{attendanceId} {
       allow read, list, write: if hasPermission('manage:attendance');
    }
    
    // Mural de Comunicados
    match /announcements/{announcementId} {
      allow read, list: if isSignedIn();
      allow write: if hasPermission('manage:announcements');
    }
  }
}
