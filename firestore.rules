
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      // isOwner is only called after isSignedIn, so request.auth is safe.
      return request.auth.uid == userId;
    }
    
    function hasPermission(permission) {
      // 1. Must be signed in to have any permission.
      if (!isSignedIn()) {
        return false;
      }

      // 2. Check for Admin override via Custom Claims.
      if (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.profileId == 'Administrador' || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.profileId == 'Administrador(a)') {
        return true;
      }

      // 3. Get the user's profile data.
      let userProfile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      if (userProfile == null || !('profileId' in userProfile)) {
        return false;
      }
      
      // 4. Get the profile's permissions list.
      let profileDoc = get(/databases/$(database)/documents/profiles/$(userProfile.profileId)).data;
      if (profileDoc == null || !('permissions' in profileDoc)) {
         return false;
      }
      
      // 5. Check if the required permission is in the profile's list.
      return permission in profileDoc.permissions;
    }

    // --- Collection Rules ---

    // Users can update their own data.
    // Any authenticated user can READ another user's profile (needed for `hasPermission`).
    match /users/{userId} {
      allow read, list: if isSignedIn();
      allow create, update: if isOwner(userId) || hasPermission('manage:users') || hasPermission('manage:students');
      allow delete: if hasPermission('manage:users');
    }
    
    // All authenticated users can read/list profiles.
    // Only admins can write.
    match /profiles/{profileId} {
        allow read, list: if isSignedIn();
        allow write: if hasPermission('manage:profiles');
    }

    match /alunos/{alunoId} {
      allow read, list: if hasPermission('view:students') || hasPermission('manage:students') || hasPermission('manage:migration');
      // Allow update if user has specific migration permission OR general student management permission
      allow update: if hasPermission('manage:migration') || hasPermission('manage:students') || hasPermission('manage:grades');
      allow create, delete: if hasPermission('manage:students') || hasPermission('manage:migration');
    }

    match /exalunos/{alunoId} {
      allow read, list: if hasPermission('view:students') || hasPermission('manage:students') || hasPermission('manage:migration');
      allow write: if isSignedIn();
    }

    match /servidores/{servidorId} {
      allow read, write: if isSignedIn();
    }

    // Permissions for grades.
    match /grades/{gradeId} {
       allow read, list: if hasPermission('view:grades') || hasPermission('manage:grades');
       allow write: if hasPermission('manage:grades');
    }

    // Permissions for attendance.
    match /attendance/{attendanceId} {
       allow read, list: if hasPermission('view:attendance') || hasPermission('manage:attendance');
       allow write: if hasPermission('manage:attendance');
    }
    
    // Permissions for announcements.
    match /announcements/{announcementId} {
      allow read, list: if hasPermission('view:announcements') || hasPermission('manage:announcements');
      allow write: if hasPermission('manage:announcements');
    }
  }
}
