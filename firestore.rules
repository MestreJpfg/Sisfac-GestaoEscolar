rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function hasPermission(permission) {
      // 1. Verificar se o documento do usuário existe
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      if (!userDoc.exists) {
        return false;
      }
      
      let userData = userDoc.data;
      
      // 2. Administradores têm acesso total bypassando outras verificações
      if (userData.profileId == 'Administrador' || userData.profileId == 'Administrador(a)') {
        return true;
      }
      
      // 3. Verifica se a permissão está nos customPermissions do usuário (como array)
      if ('customPermissions' in userData && permission in userData.customPermissions) {
        return true;
      }

      // 4. Verifica permissões herdadas do perfil
      if ('profileId' in userData && userData.profileId != null) {
        let profilePath = /databases/$(database)/documents/profiles/$(userData.profileId);
        if (exists(profilePath)) {
          let profileData = get(profilePath).data;
          // Verifica se o campo da permissão existe e é verdadeiro no mapa de permissões do perfil
          return 'permissions' in profileData && 
                 permission in profileData.permissions && 
                 profileData.permissions[permission] == true;
        }
      }

      return false;
    }

    match /users/{userId} {
      allow read, list: if isSignedIn();
      allow create, update: if isOwner(userId) || hasPermission('manage:users');
      allow delete: if hasPermission('manage:users');
    }
    
    match /profiles/{profileId} {
        allow read, list: if isSignedIn();
        allow write: if hasPermission('manage:profiles');
    }

    match /servidores/{servidorId} {
      allow read, list: if hasPermission('manage:cadastros');
      allow write: if hasPermission('manage:cadastros');
    }

    match /alunos/{alunoId} {
      allow read, list: if hasPermission('view:students');
      allow write: if hasPermission('manage:students') || hasPermission('manage:migration');
    }
    
    match /exalunos/{alunoId} {
      allow read, list: if hasPermission('view:students');
      allow write: if hasPermission('manage:migration');
    }

    match /ocorrencias/{ocorrenciaId} {
      allow read, list: if isSignedIn();
      allow write: if hasPermission('manage:occurrences');
    }

    match /grades/{gradeId} {
       allow read, list: if hasPermission('view:grades');
       allow write: if hasPermission('manage:grades');
    }

    match /attendance/{attendanceId} {
       allow read, list: if hasPermission('view:attendance');
       allow write: if hasPermission('manage:attendance');
    }
    
    match /announcements/{announcementId} {
      allow read, list: if isSignedIn();
      allow write: if hasPermission('manage:announcements');
    }
  }
}