rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ATENÇÃO: Estas regras permitem acesso total à sua base de dados.
    // Use apenas para depuração e reverta para regras seguras o mais rápido possível.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
