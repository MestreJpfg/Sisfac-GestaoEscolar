
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      if (!isSignedIn()) {
        return null;
      }
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserProfile() {
      let userData = getUserData();
      if (userData == null || !('profileId' in userData) || userData.profileId == null) {
        return null;
      }
      return get(/databases/$(database)/documents/profiles/$(userData.profileId)).data;
    }
    
    function hasPermission(permission) {
      if (!isSignedIn()) {
        return false;
      }

      let userData = getUserData();
      
      if (userData == null) {
        return false;
      }
      
      if (userData.profileId == 'Administrador' || userData.profileId == 'Administrador(a)') {
        return true;
      }
      
      let userProfile = getUserProfile();
      
      if (userProfile != null && 'permissions' in userProfile && userProfile.permissions is list && permission in userProfile.permissions) {
        return true;
      }
        
      if ('customPermissions' in userData && userData.customPermissions is list && permission in userData.customPermissions) {
        return true;
      }

      return false;
    }

    match /users/{userId} {
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow read: if isSignedIn() && (request.auth.uid == userId || hasPermission('manage:users'));
      allow list, write: if hasPermission('manage:users');
    }
    
    match /profiles/{profileId} {
        allow write: if hasPermission('manage:cadastros');
        allow read, list: if isSignedIn();
    }

    match /grades/{gradeId} {
       allow read: if isSignedIn();
       allow write: if hasPermission('manage:grades');
    }

    match /attendance/{attendanceId} {
       allow read: if isSignedIn();
       allow write: if hasPermission('manage:attendance');
    }
    
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if hasPermission('manage:announcements');
    }

    match /alunos/{alunoId} {
      allow read, list: if hasPermission('manage:students') || hasPermission('view:students');
      allow write: if hasPermission('manage:students');
    }

    match /funcionarios/{funcionarioId} {
      allow read, write, list: if hasPermission('manage:cadastros');
    }

    match /disciplinas/{disciplinaId} {
      allow read, write, list: if request.auth != null;
    }

    match /mural/{messageId} {
      allow read, write, list: if isSignedIn();
    }
  }
}
