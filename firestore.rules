
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    // Function to get the user's own data from the 'users' collection
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Function to get the complete profile data based on the user's profileId
    function getUserProfile() {
      let userData = getUserData();
      return get(/databases/$(database)/documents/profiles/$(userData.profileId)).data;
    }
    
    // NEW, more robust permission check
    function hasPermission(permission) {
      let userData = getUserData();
      let userProfile = getUserProfile();
      
      // The 'Administrador' profile always has all permissions.
      return userData.profileId == 'Administrador'
        // Check for the permission in the profile's permission list
        || permission in userProfile.permissions
        // Check for the permission in the user's specific custom permissions
        || (userData.customPermissions != null && permission in userData.customPermissions);
    }

    match /users/{userId} {
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow read: if isSignedIn() && (request.auth.uid == userId || hasPermission('manage:users'));
      allow write: if hasPermission('manage:users');
      allow list: if hasPermission('manage:users');
    }
    
    match /profiles/{profileId} {
        allow write: if hasPermission('manage:profiles');
        // Any authenticated user can read profiles to allow UI selects/dropdowns to be populated.
        allow read, list: if isSignedIn();
    }

    match /classes/{classId} {
      allow read, list: if isSignedIn();
      allow write: if hasPermission('manage:classes');
    }
    
    match /grades/{gradeId} {
       allow read: if isSignedIn();
       allow write: if hasPermission('manage:grades');
    }

    match /attendance/{attendanceId} {
       allow read: if isSignedIn();
       allow write: if hasPermission('manage:attendance');
    }
    
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if hasPermission('manage:announcements');
    }

    match /alunos/{alunoId} {
      allow read, write, list: if isSignedIn();
    }
  }
}
