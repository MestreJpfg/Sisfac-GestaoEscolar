
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      // isOwner is only called after isSignedIn, so request.auth is safe.
      return request.auth.uid == userId;
    }
    
    function hasPermission(permission) {
      // 1. Must be signed in to have any permission.
      if (!isSignedIn()) {
        return false;
      }

      // 2. Get the user's data from the /users collection.
      let userData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      
      // If user document doesn't exist, they have no permissions.
      if (userData == null || !('profileId' in userData)) {
        return false;
      }
      
      // 3. Check for Admin override.
      // Note: Use a list for multiple admin role names for easier maintenance.
      if (userData.profileId in ['Administrador', 'Administrador(a)']) {
        return true;
      }
      
      // 4. Check for individual custom permissions on the user document.
      if ('customPermissions' in userData && permission in userData.customPermissions) {
          return true;
      }

      // 5. Check for permissions granted by the user's profile.
      let profilePath = /databases/$(database)/documents/profiles/$(userData.profileId);
      if (exists(profilePath)) {
        let profilePermissions = get(profilePath).data.permissions;
        // Correctly check if the permission string exists in the array
        if (permission in profilePermissions) {
          return true;
        }
      }
        
      return false;
    }

    // --- Collection Rules ---

    // Users can update their own data.
    // Any authenticated user can READ another user's profile (needed for `hasPermission`).
    match /users/{userId} {
      allow read, list: if isSignedIn();
      allow create, update: if isOwner(userId) || hasPermission('manage:users');
      allow delete: if hasPermission('manage:users');
    }
    
    // All authenticated users can read/list profiles.
    // Only those with 'manage:cadastros' can write.
    match /profiles/{profileId} {
        allow read, list: if isSignedIn();
        allow write: if hasPermission('manage:cadastros');
    }

    // Permissions for students.
    match /alunos/{alunoId} {
      allow read, list: if hasPermission('view:students') || hasPermission('manage:students');
      allow write: if hasPermission('manage:students');
    }

    // Permissions for employees.
    match /funcionarios/{funcionarioId} {
      allow read, list, write: if hasPermission('manage:cadastros');
    }

    // Permissions for disciplines.
    match /disciplinas/{disciplinaId} {
       allow read, list, write: if hasPermission('manage:cadastros');
    }
    
    // ANY authenticated user can interact with the message board.
    match /mural/{messageId} {
      allow read, list, write: if isSignedIn();
    }

    // Permissions for grades.
    match /grades/{gradeId} {
       allow read: if isSignedIn();
       allow write: if hasPermission('manage:grades');
    }

    // Permissions for attendance.
    match /attendance/{attendanceId} {
       allow read: if isSignedIn();
       allow write: if hasPermission('manage:attendance');
    }
    
    // Permissions for announcements.
    match /announcements/{announcementId} {
      allow read, list: if isSignedIn();
      allow write: if hasPermission('manage:announcements');
    }
  }
}
