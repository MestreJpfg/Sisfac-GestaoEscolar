
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function hasPermission(permission) {
      // Se o documento do usuário não existir, não tem permissão
      if (!exists(/databases/$(database)/documents/users/$(request.auth.uid))) {
        return false;
      }
      
      let userData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      
      // Administradores têm acesso total bypassando outras verificações
      if (userData.profileId == 'Administrador' || userData.profileId == 'Administrador(a)') {
        return true;
      }
      
      if (!('profileId' in userData) || userData.profileId == null) {
        return false;
      }
      
      // Verifica se a permissão está explicitamente nos customPermissions do usuário (como array)
      let hasCustom = ('customPermissions' in userData) && (permission in userData.customPermissions);
      if (hasCustom) return true;

      // Se o perfil não existir na coleção de perfis, para aqui
      if (!exists(/databases/$(database)/documents/profiles/$(userData.profileId))) {
        return false;
      }

      let profileDoc = get(/databases/$(database)/documents/profiles/$(userData.profileId)).data;
      
      // Verificação robusta do mapa de permissões
      if (!('permissions' in profileDoc) || profileDoc.permissions == null) {
        return false;
      }
      
      // Verifica se o campo da permissão existe e é explicitamente verdadeiro
      return (permission in profileDoc.permissions) && (profileDoc.permissions[permission] == true);
    }

    match /users/{userId} {
      allow read, list: if isSignedIn();
      allow create, update: if isOwner(userId) || hasPermission('manage:users');
      allow delete: if hasPermission('manage:users');
    }
    
    match /profiles/{profileId} {
        allow read, list: if isSignedIn();
        allow write: if hasPermission('manage:profiles');
    }

    match /servidores/{servidorId} {
      allow read, list, write: if hasPermission('manage:cadastros');
    }

    match /alunos/{alunoId} {
      allow read, list: if hasPermission('view:students');
      allow write: if hasPermission('manage:students') || hasPermission('manage:migration');
    }
    
    match /exalunos/{alunoId} {
      allow read, list: if hasPermission('view:students');
      allow write: if hasPermission('manage:migration');
    }

    match /ocorrencias/{ocorrenciaId} {
      allow read, list: if isSignedIn();
      allow write: if hasPermission('manage:occurrences');
    }

    match /grades/{gradeId} {
       allow read, list: if hasPermission('view:grades');
       allow write: if hasPermission('manage:grades');
    }

    match /attendance/{attendanceId} {
       allow read, list: if hasPermission('view:attendance');
       allow write: if hasPermission('manage:attendance');
    }
    
    match /announcements/{announcementId} {
      allow read, list: if isSignedIn();
      allow write: if hasPermission('manage:announcements');
    }
  }
}
