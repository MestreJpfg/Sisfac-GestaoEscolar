rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData(userId) {
      // This function gets a user's profile data.
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }
    
    function hasPermission(permission) {
      if (!isSignedIn()) {
        return false;
      }

      let userData = getUserData(request.auth.uid);
      
      if (userData == null) {
        return false;
      }
      
      // Admin override: checks if the profile ID is administrator.
      if (userData.profileId == 'Administrador' || userData.profileId == 'Administrador(a)') {
        return true;
      }
      
      // Check user's profile permissions.
      // The `exists` check is crucial before accessing `data`.
      let profilePath = /databases/$(database)/documents/profiles/$(userData.profileId);
      if (exists(profilePath) && permission in get(profilePath).data.permissions) {
        return true;
      }
        
      // Check individual custom permissions.
      if ('customPermissions' in userData && userData.customPermissions.hasAny([permission])) {
        return true;
      }

      return false;
    }

    // --- Collection Rules ---

    // Users can update their own data.
    // Any authenticated user can READ another user's profile (needed for `hasPermission`).
    match /users/{userId} {
      allow read: if isSignedIn();
      allow update: if isOwner(userId); 
      allow list: if hasPermission('manage:users');
    }
    
    // All authenticated users can read/list profiles.
    // Only those with 'manage:cadastros' can write.
    match /profiles/{profileId} {
        allow read, list: if isSignedIn();
        allow write: if hasPermission('manage:cadastros');
    }

    // Permissions for students.
    match /alunos/{alunoId} {
      allow read, list: if hasPermission('view:students') || hasPermission('manage:students');
      allow write: if hasPermission('manage:students');
    }

    // Permissions for employees.
    match /funcionarios/{funcionarioId} {
      allow read, list, write: if hasPermission('manage:cadastros');
    }

    // Permissions for disciplines.
    match /disciplinas/{disciplinaId} {
       allow read, list, write: if hasPermission('manage:cadastros');
    }
    
    // ANY authenticated user can interact with the message board.
    match /mural/{messageId} {
      allow read, list, write: if isSignedIn();
    }

    // Permissions for grades.
    match /grades/{gradeId} {
       allow read: if isSignedIn();
       allow write: if hasPermission('manage:grades');
    }

    // Permissions for attendance.
    match /attendance/{attendanceId} {
       allow read: if isSignedIn();
       allow write: if hasPermission('manage:attendance');
    }
    
    // Permissions for announcements.
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if hasPermission('manage:announcements');
    }
  }
}
