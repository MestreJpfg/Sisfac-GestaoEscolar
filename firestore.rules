rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData(userId) {
      // Allow reading user data if it's for the currently signed-in user.
      // This is necessary for hasPermission to work for non-admin users checking their own permissions.
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }
    
    function hasPermission(permission) {
      if (!isSignedIn()) {
        return false;
      }

      let userData = getUserData(request.auth.uid);
      
      if (userData == null) {
        return false;
      }
      
      // Admin override: check for specific profile names for admin access.
      if (userData.profileId == 'Administrador' || userData.profileId == 'Administrador(a)') {
        return true;
      }
      
      // Check permissions from the user's assigned profile.
      if (userData.profileId != null) {
        let profileData = get(/databases/$(database)/documents/profiles/$(userData.profileId)).data;
        if (profileData != null && permission in profileData.permissions) {
          return true;
        }
      }
        
      // Check for individual custom permissions assigned directly to the user.
      if ('customPermissions' in userData && permission in userData.customPermissions) {
        return true;
      }

      return false;
    }

    // --- Collection Rules ---

    // Users can read/update their own data.
    // Users with 'manage:users' permission can read any user's data and list all users.
    match /users/{userId} {
      allow read, update: if isOwner(userId);
      allow get, list: if hasPermission('manage:users');
    }
    
    // All signed-in users can read/list profiles (e.g., for dropdowns).
    // Only users with 'manage:cadastros' can create, update, or delete profiles.
    match /profiles/{profileId} {
        allow read, list: if isSignedIn();
        allow write: if hasPermission('manage:cadastros');
    }

    // Permissions for students data.
    match /alunos/{alunoId} {
      allow read, list: if hasPermission('view:students') || hasPermission('manage:students');
      allow write: if hasPermission('manage:students');
    }

    // Permissions for employees data.
    match /funcionarios/{funcionarioId} {
      allow read, list, write: if hasPermission('manage:cadastros');
    }

    // Permissions for subjects data.
    match /disciplinas/{disciplinaId} {
       allow read, list, write: if hasPermission('manage:cadastros');
    }
    
    // Any signed-in user can interact with the message board.
    match /mural/{messageId} {
      allow read, write, list: if isSignedIn();
    }

    // Permissions for grades.
    match /grades/{gradeId} {
       allow read: if isSignedIn();
       allow write: if hasPermission('manage:grades');
    }

    // Permissions for attendance.
    match /attendance/{attendanceId} {
       allow read: if isSignedIn();
       allow write: if hasPermission('manage:attendance');
    }
    
    // Permissions for announcements.
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if hasPermission('manage:announcements');
    }
  }
}
