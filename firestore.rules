
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() in ['mestrejpfg@gmail.com', 'fortalezaem@gmail.com'] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('profileId', '') in ['Administrador', 'Administrador(a)'])
      );
    }
    
    function hasPermission(permission) {
      if (!isSignedIn()) return false;
      if (isAdmin()) return true;

      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      if (!exists(userPath)) return false;
      
      let userData = get(userPath).data;
      if (permission in userData.get('customPermissions', [])) return true;

      let pId = userData.get('profileId', '');
      if (pId != '') {
        let profilePath = /databases/$(database)/documents/profiles/$(pId);
        if (exists(profilePath)) {
          let permissions = get(profilePath).data.get('permissions', {});
          return permissions.get(permission, false) == true;
        }
      }

      return false;
    }

    // Regra Mestra: Administradores têm acesso TOTAL
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Regras específicas baseadas em permissões unificadas
    match /users/{userId} {
      allow read, list: if isSignedIn();
      allow create, update: if request.auth.uid == userId || hasPermission('manage:users');
      allow delete: if hasPermission('manage:users');
    }
    
    match /profiles/{profileId} {
        allow read, list: if isSignedIn();
        allow write: if hasPermission('manage:users');
    }

    match /servidores/{servidorId} {
      allow read, list, write: if hasPermission('manage:cadastros');
    }

    match /alunos/{alunoId} {
      allow read, list, write: if hasPermission('manage:students') || hasPermission('manage:migration');
    }
    
    match /exalunos/{alunoId} {
      allow read, list, write: if hasPermission('manage:students') || hasPermission('manage:migration');
    }

    match /ocorrencias/{ocorrenciaId} {
      allow read, list, write: if hasPermission('manage:occurrences');
    }

    match /grades/{gradeId} {
       allow read, list, write: if hasPermission('manage:grades');
    }

    match /attendance/{attendanceId} {
       allow read, list, write: if hasPermission('manage:attendance');
    }
    
    match /announcements/{announcementId} {
      allow read, list: if isSignedIn();
      allow write: if hasPermission('manage:announcements');
    }
  }
}
