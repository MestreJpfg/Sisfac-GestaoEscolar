rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData(userId) {
      // Esta função obtém os dados do perfil de um utilizador.
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }
    
    function hasPermission(permission) {
      if (!isSignedIn()) {
        return false;
      }

      let userData = getUserData(request.auth.uid);
      
      if (userData == null) {
        return false;
      }
      
      // Admin override: verifica se o ID do perfil é de administrador.
      if (userData.profileId == 'Administrador' || userData.profileId == 'Administrador(a)') {
        return true;
      }
      
      // Verifica as permissões do perfil do utilizador.
      let profileData = get(/databases/$(database)/documents/profiles/$(userData.profileId)).data;
      if (profileData != null && permission in profileData.permissions) {
        return true;
      }
        
      // Verifica permissões personalizadas individuais.
      if ('customPermissions' in userData && permission in userData.customPermissions) {
        return true;
      }

      return false;
    }

    // --- Collection Rules ---

    // Utilizadores podem atualizar os seus próprios dados.
    // Qualquer utilizador autenticado pode LER o perfil de outro utilizador (necessário para `hasPermission`).
    // Apenas quem tem a permissão 'manage:users' pode LISTAR todos os utilizadores.
    match /users/{userId} {
      allow update: if isOwner(userId);
      allow get: if isSignedIn(); 
      allow list: if hasPermission('manage:users');
    }
    
    // Todos os utilizadores autenticados podem ler/listar perfis.
    // Apenas quem tem 'manage:cadastros' pode escrever.
    match /profiles/{profileId} {
        allow read, list: if isSignedIn();
        allow write: if hasPermission('manage:cadastros');
    }

    // Permissões para alunos.
    match /alunos/{alunoId} {
      allow read, list: if hasPermission('view:students') || hasPermission('manage:students');
      allow write: if hasPermission('manage:students');
    }

    // Permissões para funcionários.
    match /funcionarios/{funcionarioId} {
      allow read, list, write: if hasPermission('manage:cadastros');
    }

    // Permissões para disciplinas.
    match /disciplinas/{disciplinaId} {
       allow read, list, write: if hasPermission('manage:cadastros');
    }
    
    // QUALQUER utilizador autenticado pode interagir com o mural.
    match /mural/{messageId} {
      allow read, write, list: if isSignedIn();
    }

    // Permissões para notas.
    match /grades/{gradeId} {
       allow read: if isSignedIn();
       allow write: if hasPermission('manage:grades');
    }

    // Permissões para frequência.
    match /attendance/{attendanceId} {
       allow read: if isSignedIn();
       allow write: if hasPermission('manage:attendance');
    }
    
    // Permissões para anúncios.
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if hasPermission('manage:announcements');
    }
  }
}
