
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.get('email', '') in ['mestrejpfg@gmail.com', 'fortalezaem@gmail.com'] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('profileId', '') in ['Administrador', 'Administrador(a)'])
      );
    }
    
    function hasPermission(permission) {
      if (!isSignedIn()) return false;
      
      // Admin bypass total
      if (isAdmin()) return true;

      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      if (!exists(userPath)) return false;
      
      let userData = get(userPath).data;
      
      // Verifica permissão individual
      if (permission in userData.get('customPermissions', [])) {
        return true;
      }

      // Verifica permissões herdadas do perfil
      let pId = userData.get('profileId', '');
      if (pId != '') {
        let profilePath = /databases/$(database)/documents/profiles/$(pId);
        if (exists(profilePath)) {
          let profileData = get(profilePath).data;
          let permissions = profileData.get('permissions', {});
          return permissions.get(permission, false) == true;
        }
      }

      return false;
    }

    match /users/{userId} {
      allow read, list: if isSignedIn();
      allow create, update: if isOwner(userId) || isAdmin() || hasPermission('manage:users');
      allow delete: if isAdmin() || hasPermission('manage:users');
    }
    
    match /profiles/{profileId} {
        allow read, list: if isSignedIn();
        allow write: if isAdmin() || hasPermission('manage:profiles');
    }

    match /servidores/{servidorId} {
      allow read, list: if isAdmin() || hasPermission('manage:cadastros');
      allow write: if isAdmin() || hasPermission('manage:cadastros');
    }

    match /alunos/{alunoId} {
      allow read, list: if isAdmin() || hasPermission('view:students');
      allow write: if isAdmin() || hasPermission('manage:students') || hasPermission('manage:migration');
    }
    
    match /exalunos/{alunoId} {
      allow read, list: if isAdmin() || hasPermission('view:students');
      allow write: if isAdmin() || hasPermission('manage:migration');
    }

    match /ocorrencias/{ocorrenciaId} {
      allow read, list: if isAdmin() || hasPermission('manage:occurrences');
      allow write: if isAdmin() || hasPermission('manage:occurrences');
    }

    match /grades/{gradeId} {
       allow read, list: if isAdmin() || hasPermission('view:grades');
       allow write: if isAdmin() || hasPermission('manage:grades');
    }

    match /attendance/{attendanceId} {
       allow read, list: if isAdmin() || hasPermission('view:attendance');
       allow write: if isAdmin() || hasPermission('manage:attendance');
    }
    
    match /announcements/{announcementId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin() || hasPermission('manage:announcements');
    }
  }
}
